# ─────────────────────────────────────────────────────────────────────
#  Fruit Market — environment configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
#
# Sponsor APIs (5 services in scope for the MVP):
#   • AgentPhone   — telephony + outbound SMS/iMessage     (host sponsor)
#   • Gemini       — conversation brain                    (Google AI)
#   • Stripe       — payment Checkout + webhooks           (test mode)
#   • AgentMail    — email delivery for payment links      (S25)
#   • Moss         — semantic catalog resolution           (stretch goal)
#
# Filling in is staged — you only need each block when the matching
# build phase is in progress. See BUILD_PLAN.md.
# ─────────────────────────────────────────────────────────────────────


# ═════ AgentPhone ════════════════════════════════════════════════════
# Get from https://agentphone.ai dashboard → Settings → API Keys
# Create an agent + buy a number first. Number capabilities should
# include SMS and (optionally) iMessage on Apple-Business-Chat.
AGENTPHONE_API_BASE=https://api.agentphone.ai/v1
AGENTPHONE_API_KEY=apk_REPLACE_ME
AGENTPHONE_AGENT_ID=REPLACE_ME              # the agent's id from the dashboard
AGENTPHONE_NUMBER=+1REPLACE_ME              # E.164 format
AGENTPHONE_NUMBER_ID=REPLACE_ME             # the phone number resource id
AGENTPHONE_SEND_MODE=live                   # live | mock | disabled

# Webhook signing secret — auto-populated by ./demo on first run when
# it rotates the agent's webhook URL to point at the live tunnel.
# Leave blank initially.
# AGENTPHONE_WEBHOOK_SECRET=whsec_...


# ═════ Gemini ════════════════════════════════════════════════════════
# Get from https://aistudio.google.com/apikey (free tier covers a hackathon).
GEMINI_API_KEY=AIzaREPLACE_ME

# Optional overrides — defaults work for the MVP
# CV_GEMINI_MODEL=gemini-flash-3.1            # set when 3.1 ships; verify name at build time
# CV_GEMINI_THINKING_BUDGET=512                # 0 disables thinking on Flash


# ═════ Stripe (test mode) ════════════════════════════════════════════
# Get from https://dashboard.stripe.com/test/apikeys (stay in TEST MODE).
# For the webhook secret: Developers → Webhooks → Add endpoint (any temp
# URL is fine — ./demo rotates the real URL on every cold start).
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Success / cancel URLs — auto-populated by ./demo to the live tunnel
# on every cold start. Leave blank initially.
# STRIPE_SUCCESS_URL=https://<tunnel>.trycloudflare.com/?paid=1
# STRIPE_CANCEL_URL=https://<tunnel>.trycloudflare.com/?cancelled=1


# ═════ AgentMail ═════════════════════════════════════════════════════
# Get from https://agentmail.to dashboard → Settings → API Keys + create
# an inbox. AGENTMAIL_ADDRESS is the FULL email address (e.g.,
# fruitmarket-1234@agentmail.to), NOT just the local-part — the API
# uses it as the inbox identifier.
AGENTMAIL_API_KEY=am_REPLACE_ME
AGENTMAIL_ADDRESS=REPLACE_ME@agentmail.to
AGENTMAIL_ENABLED=1                          # must be "1" — empty/blank = disabled
AGENTMAIL_API_BASE=https://api.agentmail.to/v0


# ═════ Moss (stretch) ═══════════════════════════════════════════════
# Semantic catalog resolution. Only useful with 3+ items in catalog.
# Get from `moss init` or the Moss dashboard. Moss uses project-scoped
# credentials (project_id + project_key, not a flat api_key).
MOSS_ENABLED=0                               # 1 to enable; 0 = use lexical match only
MOSS_PROJECT_ID=REPLACE_ME                   # uuid
MOSS_PROJECT_KEY=moss_REPLACE_ME             # starts with "moss_"
MOSS_API_BASE=https://api.moss.ai/v1         # verify with their docs


# ═════ Vision / camera ══════════════════════════════════════════════
# Local MLX inference settings.
CV_CAMERA_SOURCE=broker                      # broker (Swift) | direct (skip for now)
CV_VISION_POLL_SECONDS=3                     # how often the watcher counts items
CV_AUTO_APPLY_VISION=1                       # 1 = camera writes inventory automatically
                                             # 0 = operator must confirm each count
CV_MLX_MODEL=mlx-community/paligemma2-3b-mix-224-bf16
# CV_MLX_MODEL_PATH=                         # set if model is at a custom path


# ═════ Operator + demo settings ═════════════════════════════════════
OPERATOR_PHONE=+1REPLACE_ME                  # your personal phone for test calls
CV_REHEARSAL_MODE=1                          # enables /api/orders/<id>/paid/rehearsal
                                             # endpoint for offline payment fakes

# Multi-product (stretch — off for safe single-item demo)
# CV_MULTI_PRODUCT=1
# CV_MULTI_PRODUCT_ITEMS=Banana:5:100,Apple:3:150


# ═════ Venue answers (what the agent says about location/hours) ═════
# These get returned by the brain's get_venue_info tool when callers
# ask "where are you?", "are you open?", etc. Customize per event.
VENUE_NAME=Fruit Market
VENUE_LOCATION=YC HQ, 320 Pioneer Way, Mountain View, CA
VENUE_HOURS_TODAY=Open until 6pm
VENUE_PICKUP=Come to the front counter, show your order email or SMS.
