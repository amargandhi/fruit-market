# ─────────────────────────────────────────────────────────────────────
#  Fruit Market — environment configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
#
# Sponsor APIs (5 services in scope for the MVP):
#   • AgentPhone   — telephony + outbound SMS/iMessage
#   • Gemini       — conversation brain
#   • Stripe       — payment Checkout + webhooks (test mode)
#   • AgentMail    — email delivery for receipts / payment links
#   • Moss         — semantic catalog resolution
#
# You only need each block when the matching build phase begins.
# ─────────────────────────────────────────────────────────────────────


# ═════ AgentPhone ════════════════════════════════════════════════════
# Get from https://agentphone.ai dashboard → Settings → API Keys.
# Create an agent + buy a number first. Number capabilities should
# include SMS and (optionally) iMessage via Apple-Business-Chat.
AGENTPHONE_API_BASE=https://api.agentphone.ai/v1
AGENTPHONE_API_KEY=apk_REPLACE_ME
AGENTPHONE_AGENT_ID=REPLACE_ME              # the agent's id from the dashboard
AGENTPHONE_NUMBER=+1REPLACE_ME              # E.164 — agent's primary (SMS + Voice)
AGENTPHONE_NUMBER_ID=REPLACE_ME             # the phone number resource id
AGENTPHONE_SEND_MODE=live                   # live | mock | disabled

# Optional second number for iMessage delivery. AgentPhone separates
# transport: SMS goes from your agent's voice number, iMessage from a
# shared Apple-Business-Chat number. Leave blank to send everything as
# SMS from AGENTPHONE_NUMBER.
# AGENTPHONE_IMESSAGE_NUMBER=+1REPLACE_ME
# AGENTPHONE_IMESSAGE_NUMBER_ID=REPLACE_ME

# Webhook signing secret — set after you point the agent's webhook URL
# at your local tunnel.
# AGENTPHONE_WEBHOOK_SECRET=whsec_...


# ═════ Gemini ════════════════════════════════════════════════════════
# Get from https://aistudio.google.com/apikey (free tier is fine).
GEMINI_API_KEY=AIzaREPLACE_ME
GEMINI_MODEL=gemini-3.1-flash-lite
# Low is the best default for SMS/webhook latency. Raise to high only
# when you prefer slower, deeper reasoning.
GEMINI_THINKING_LEVEL=low
# Bounded automatic function-calling loop for catalog → reserve →
# checkout flows. Raise only if the agent starts valid multi-step work.
GEMINI_MAX_REMOTE_CALLS=6


# ═════ Stripe (test mode) ════════════════════════════════════════════
# Get from https://dashboard.stripe.com/test/apikeys (stay in TEST MODE).
# For the webhook secret: Developers → Webhooks → Add endpoint.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Success / cancel URLs — fill in once your public URL is known.
# STRIPE_SUCCESS_URL=https://example.com/?paid=1
# STRIPE_CANCEL_URL=https://example.com/?cancelled=1


# ═════ AgentMail ═════════════════════════════════════════════════════
# Get from https://agentmail.to dashboard → Settings → API Keys, then
# create an inbox. AGENTMAIL_ADDRESS is the FULL email address (e.g.,
# fruitmarket-1234@agentmail.to), NOT just the local-part — the API
# uses it as the inbox identifier.
AGENTMAIL_API_KEY=am_REPLACE_ME
AGENTMAIL_ADDRESS=REPLACE_ME@agentmail.to
AGENTMAIL_ENABLED=1                          # must be "1" — empty/blank = disabled
AGENTMAIL_API_BASE=https://api.agentmail.to/v0


# ═════ Moss ═════════════════════════════════════════════════════════
# Semantic catalog resolution. Get credentials via `moss init` or from
# the Moss dashboard. Moss uses project-scoped credentials.
# The API is RPC-style: POST /manage with body
#   {"action": "<camelCaseAction>", "projectId": "...", "projectKey": "...", ...}
MOSS_ENABLED=0                               # 1 to enable; 0 = use lexical match only
MOSS_PROJECT_ID=REPLACE_ME                   # uuid
MOSS_PROJECT_KEY=moss_REPLACE_ME             # starts with "moss_"
MOSS_API_BASE=https://service.usemoss.dev/v1


# ═════ Operator + venue answers ═════════════════════════════════════
# OPERATOR_PHONE is your personal number for test calls.
# Venue fields are returned by the brain when callers ask
# "where are you?", "are you open?", etc. Customize per event.
OPERATOR_PHONE=+1REPLACE_ME
VENUE_NAME=Fruit Market
VENUE_LOCATION=REPLACE_ME
VENUE_HOURS_TODAY=REPLACE_ME
VENUE_PICKUP=Come to the front counter, show your order email or SMS.
